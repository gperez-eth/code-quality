# The worker and CI. Copy this file to .env.
#
# `npm run worker` and `npm run publish` load it with
# `node --env-file-if-exists=.env`; nothing loads it implicitly.
#
# The dashboard reads its own file — see apps/web/.env.example. Everything
# reaches the database through the Supabase API: there is no Postgres
# connection string, and no encryption key either, because repository tokens go
# into Supabase Vault. The app holds no secret of its own.

# The service role key bypasses RLS entirely. It belongs to the analysis worker
# and to `code-quality-import` in CI — never to a browser, and never to the
# dashboard process. Settings -> API -> service_role.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# How often the worker asks for work when the queue is empty. Default 5000.
# CODE_QUALITY_POLL_MS="5000"

# Where the worker clones repositories. Defaults to a folder in the system temp dir.
# CODE_QUALITY_WORKSPACE="C:\Users\you\.code-quality\repos"

# Only for `code-quality-import`, when --org is not passed.
# CODE_QUALITY_ORG="<organisation-slug>"

# The dashboard's own credentials. Copy this file to apps/web/.env.
#
# They belong here, not in the repo root: Next.js loads .env files from the
# project directory only, so a root .env is invisible to it — every request
# then fails in the proxy with "Your project's URL and Key are required".
#
# Nothing secret goes in this file. The publishable key is public by design and
# RLS decides what it can see. SUPABASE_SERVICE_ROLE_KEY belongs in the root
# .env, which only the worker and CI read; the dashboard must never hold it.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Only needed where the Host header cannot be trusted to build the OAuth
# callback URL, e.g. behind a proxy that rewrites it.
# NEXT_PUBLIC_SITE_URL=

# The GitHub App's slug — the last part of https://github.com/apps/<slug>.
#
# Public by design: it is the URL the browser is sent to. Unset simply hides
# the Install button, which is the right behaviour before an app exists.
#
# The app's ID and private key are NOT here and must never be. They sign as the
# app for every installation it has, they belong to the worker, and anything
# named NEXT_PUBLIC_ ends up inlined in the browser bundle.
# NEXT_PUBLIC_GITHUB_APP_SLUG="https://app.example.com"
